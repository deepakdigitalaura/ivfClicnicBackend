const DRY = process.argv.includes("--dry-run");
type L = { en: string; hi: string; gu: string };
const L = (en: string, hi: string, gu: string): L => ({ en, hi, gu });
type Tr = [string, string]; // [hi, gu]

function zip(en: string[], tr: Tr[], label: string): L[] {
  if (en.length !== tr.length) throw new Error(`${label}: length mismatch en=${en.length} tr=${tr.length}`);
  return en.map((e, i) => L(e, tr[i][0], tr[i][1]));
}
const values = (en: string[], tr: Tr[], label: string) => zip(en, tr, label).map((value) => ({ _type: "object", value }));
const cards = (items: { icon: any; t: string; d: string }[], hi: [string, string][], gu: [string, string][], label: string) => {
  if (items.length !== hi.length || items.length !== gu.length) throw new Error(`${label}: length mismatch`);
  return items.map((c, i) => ({ _type: "object", icon: iconKey(c.icon), t: L(c.t, hi[i][0], gu[i][0]), d: L(c.d, hi[i][1], gu[i][1]) }));
};
const heading = (h: { lead: string; em?: string }, lead: Tr, em: Tr) => ({ lead: L(h.lead, ...lead), em: L(h.em ?? "", ...em) });


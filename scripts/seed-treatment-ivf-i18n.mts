  ["मेरा पिछला IVF साइकल असफल रहा — इस बार क्या अलग होगा?", "दोबारा शुरू करने से पहले असफल साइकल की गहराई से समीक्षा की जाती है — भ्रूण की गुणवत्ता, लैब की स्थितियां और आपका स्टिमुलेशन प्रोटोकॉल, सबका पुनर्मूल्यांकन होता है। Bavishi Fertility Institute में इसका अर्थ है क्लास 1000 (10× स्वच्छ हवा) लैब, आपकी पिछली प्रतिक्रिया के अनुसार समायोजित व्यक्तिगत प्रोटोकॉल, और जहां आवश्यक हो, सबसे स्वस्थ भ्रूण चुनने के लिए PGT। हम सेकंड-ओपिनियन कंसल्टेशन भी देते हैं, जिसमें पिछली बार क्या हुआ और हम क्या बदलेंगे, यह विस्तार से समझाया जाता है।"],
  ["IVF पर विचार करने से पहले दंपति को कितने समय तक प्रयास करना चाहिए?", "आमतौर पर, यदि महिला की उम्र 35 वर्ष से कम है तो लगभग एक वर्ष, और 35 वर्ष या उससे अधिक होने पर छह महीने। यदि पहले से कोई फर्टिलिटी संबंधी समस्या है — या महिला की उम्र 40 से अधिक है — तो जल्दी विशेषज्ञ से मिलना समझदारी है।"],
  ["IVF और ICSI में क्या अंतर है?", "पारंपरिक IVF में अंडे और शुक्राणु को एक डिश में मिलाया जाता है। ICSI में एक स्वस्थ शुक्राणु को सीधे प्रत्येक अंडे में इंजेक्ट किया जाता है। पुरुष-कारक बांझपन या पिछले निषेचन की विफलता में ICSI को प्राथमिकता दी जाती है — Bavishi Fertility Institute में हम सभी दंपतियों के लिए ICSI का उपयोग करते हैं।"],
  ["उम्र का IVF की सफलता पर क्या प्रभाव पड़ता है?", "उम्र सबसे बड़ा कारक है — कम उम्र की महिलाओं में आमतौर पर सफलता दर अधिक होती है। अधिक उम्र के मरीज़ों के लिए डोनर एग, पहले से फ्रीज़ किए गए भ्रूण या उन्नत IVF तकनीकों जैसे विकल्प सफलता की संभावना बढ़ा सकते हैं।"],
  ["IVF का एक साइकल कितने समय का होता है?", "स्टिमुलेशन की शुरुआत से भ्रूण ट्रांसफर तक, सक्रिय उपचार में आमतौर पर लगभग 12–17 दिन लगते हैं, इसके अलावा पहले की उपचार-पूर्व जांच।"],
  ["क्या अंडा निकालना दर्दनाक है?", "नहीं। अंडा निकालना एक छोटी, दर्द-रहित प्रक्रिया है, जो हल्के सेडेशन में योनि मार्ग से की जाती है — न कोई चीरा, न टांका। अधिकांश मरीज़ लगभग दो घंटे में घर चली जाती हैं।"],
  ["Bavishi Fertility Institute में IVF की लागत कितनी है?", "लागत आपके निदान, प्रोटोकॉल और ICSI, PGT या डोनर प्रोग्राम जैसे अतिरिक्त विकल्पों पर निर्भर करती है। Bavishi Fertility Institute पारदर्शी मूल्य, बिना किसी छिपे शुल्क, आसान / ब्याज-मुक्त EMI और सुरक्षा कवच पैकेज प्रदान करता है। व्यक्तिगत अनुमान के लिए कंसल्टेशन बुक करें।"],
  ["क्या Bavishi Fertility Institute IVF के लिए वित्तीय सुरक्षा देता है?", "हाँ — सुरक्षा कवच प्रोग्राम के माध्यम से, जो कई IVF साइकल को कवर करता है और आपकी फर्टिलिटी यात्रा में वित्तीय सुरक्षा प्रदान करता है। आप पात्र हैं या नहीं, यह जानने के लिए हमारी टीम से बात करें।"],
  ["भारत का सबसे अच्छा IVF सेंटर कौन सा है?", "Bavishi Fertility Institute भारत की सबसे विश्वसनीय IVF चेन में से एक है — 1998 से 8 शहरों के 14 केंद्रों में कार्यरत, 30,000+ सफल गर्भावस्थाओं और छह बार (2019–2026) नेशनल फर्टिलिटी अवॉर्ड के साथ। हमारे अहमदाबाद संस्थान को टाइम्स ऑफ इंडिया द्वारा भारत का नंबर 1 फर्टिलिटी क्लिनिक घोषित किया गया।"],
  ["IVF शुरू करने से पहले मुझे जीवनशैली में क्या बदलाव करने चाहिए?", "स्वस्थ जीवनशैली पर ध्यान दें — संतुलित आहार, नियमित व्यायाम, स्वस्थ वज़न बनाए रखना, और धूम्रपान तथा अत्यधिक शराब से दूर रहना। परामर्श के दौरान आपके विशेषज्ञ कोई भी अतिरिक्त, व्यक्तिगत सलाह देंगे।"],
  ["क्या IVF के दौरान आहार संबंधी कोई सिफारिशें हैं?", "कोई सख्त पाबंदी नहीं है, लेकिन फल, सब्ज़ियां, साबुत अनाज और लीन प्रोटीन से भरपूर संतुलित आहार तथा पर्याप्त पानी पीना अनुशंसित है। आपके उपचार के लिए क्लिनिक जो विशेष निर्देश दे, उनका पालन करें।"],
  ["एम्ब्रियो ग्रेडिंग क्या है?", "एम्ब्रियो ग्रेडिंग में भ्रूणों की गुणवत्ता का आकलन उनके स्वरूप और विकास के आधार पर किया जाता है। उच्च ग्रेड के भ्रूणों के सफलतापूर्वक इम्प्लांट होने की संभावना अधिक होती है, इसीलिए हमारे एम्ब्रियोलॉजिस्ट ट्रांसफर के लिए सर्वोत्तम गुणवत्ता वाले भ्रूण चुनते हैं।"],
  ["क्या अकेला व्यक्ति IVF से बच्चा पा सकता है?", "हाँ, भारत में अकेली महिलाओं के लिए IVF उपचार उपलब्ध है — डोनर स्पर्म की मदद से अकेली महिला गर्भधारण कर सकती है। हमारी टीम आपको उपलब्ध विकल्प समझाएगी। दुर्भाग्य से, भारतीय कानून के तहत अकेले पुरुष फिलहाल फर्टिलिटी उपचार के पात्र नहीं हैं।"],
];
const faqGu = [
  ["IVF (ઇન વિટ્રો ફર્ટિલાઇઝેશન) શું છે?", "IVF એક આસિસ્ટેડ-રિપ્રોડક્શન ટેકનિક છે, જેમાં અંડાશયમાંથી અંડકોષ કાઢવામાં આવે છે, પ્રયોગશાળામાં શુક્રાણુ દ્વારા ફલિત કરવામાં આવે છે, અને બનેલા ભ્રૂણને ગર્ભધારણ માટે ગર્ભાશયમાં ટ્રાન્સફર કરવામાં આવે છે."],
  ["મેં IUI કરાવ્યું છે પણ હજુ ગર્ભવતી નથી થઈ — શું IVF મારું આગલું પગલું છે?", "ઘણીવાર હા. IUI સામાન્ય રીતે 3–4 સાયકલ સુધી અજમાવવામાં આવે છે; જો ત્યાં સુધી ગર્ભાવસ્થા ન થાય, અથવા બંધ ટ્યુબ, ઓછો ઓવેરિયન રિઝર્વ કે ગંભીર પુરુષ-કારક વંધ્યત્વ જેવું નિદાન હોય, તો IVF પ્રતિ સાયકલ નોંધપાત્ર રીતે વધુ સંભાવના આપે છે, કારણ કે ફલન અને ભ્રૂણનો પ્રારંભિક વિકાસ પ્રયોગશાળામાં સીધી દેખરેખ હેઠળ થાય છે. તમારા નિષ્ણાત તમારો IUI ઇતિહાસ અને ટેસ્ટ રિપોર્ટ જોઈને નક્કી કરશે કે IVF નો સમય આવી ગયો છે કે નહીં."],
  ["મારું અગાઉનું IVF સાયકલ નિષ્ફળ ગયું — આ વખતે શું અલગ હશે?", "ફરીથી શરૂ કરતા પહેલાં નિષ્ફળ સાયકલની ઊંડાણપૂર્વક સમીક્ષા કરવામાં આવે છે — ભ્રૂણની ગુણવત્તા, લેબની પરિસ્થિતિઓ અને તમારા સ્ટિમ્યુલેશન પ્રોટોકોલનું ફરી મૂલ્યાંકન થાય છે. Bavishi Fertility Institute માં તેનો અર્થ છે ક્લાસ 1000 (10× સ્વચ્છ હવા) લેબ, તમારા અગાઉના પ્રતિભાવ મુજબ ગોઠવાયેલો વ્યક્તિગત પ્રોટોકોલ, અને જ્યાં જરૂરી હોય ત્યાં સૌથી સ્વસ્થ ભ્રૂણ પસંદ કરવા માટે PGT. અમે સેકન્ડ-ઓપિનિયન કન્સલ્ટેશન પણ આપીએ છીએ, જેમાં ગત વખતે શું થયું અને અમે શું બદલીશું તે વિગતવાર સમજાવવામાં આવે છે."],
  ["IVF વિશે વિચારતા પહેલાં દંપતીએ કેટલા સમય સુધી પ્રયત્ન કરવો જોઈએ?", "સામાન્ય રીતે, જો સ્ત્રીની ઉંમર 35 વર્ષથી ઓછી હોય તો લગભગ એક વર્ષ, અને 35 વર્ષ કે તેથી વધુ હોય તો છ મહિના. જો પહેલેથી કોઈ ફર્ટિલિટી સંબંધિત સમસ્યા હોય — અથવા સ્ત્રીની ઉંમર 40 થી વધુ હોય — તો વહેલા નિષ્ણાતને મળવું સમજદારીભર્યું છે."],
  ["IVF અને ICSI વચ્ચે શું તફાવત છે?", "પરંપરાગત IVF માં અંડકોષ અને શુક્રાણુને એક ડિશમાં ભેળવવામાં આવે છે. ICSI માં એક સ્વસ્થ શુક્રાણુને સીધું દરેક અંડકોષમાં ઇન્જેક્ટ કરવામાં આવે છે. પુરુષ-કારક વંધ્યત્વ અથવા અગાઉની ફલન નિષ્ફળતામાં ICSI ને પ્રાથમિકતા આપવામાં આવે છે — Bavishi Fertility Institute માં અમે તમામ દંપતીઓ માટે ICSI નો ઉપયોગ કરીએ છીએ."],
  ["ઉંમર IVF ની સફળતાને કેવી રીતે અસર કરે છે?", "ઉંમર સૌથી મોટું પરિબળ છે — ઓછી ઉંમરની સ્ત્રીઓમાં સામાન્ય રીતે સફળતાનો દર વધુ હોય છે. વધુ ઉંમરના દર્દીઓ માટે ડોનર એગ, અગાઉ ફ્રીઝ કરેલા ભ્રૂણ અથવા અદ્યતન IVF તકનીકો જેવા વિકલ્પો સફળતાની સંભાવના વધારી શકે છે."],
  ["IVF નું એક સાયકલ કેટલો સમય ચાલે છે?", "સ્ટિમ્યુલેશનની શરૂઆતથી ભ્રૂણ ટ્રાન્સફર સુધી, સક્રિય સારવારમાં સામાન્ય રીતે લગભગ 12–17 દિવસ લાગે છે, ઉપરાંત અગાઉની સારવાર પહેલાંની તપાસ."],
  ["શું અંડકોષ કાઢવાની પ્રક્રિયા પીડાદાયક છે?", "ના. અંડકોષ કાઢવાની પ્રક્રિયા ટૂંકી, પીડારહિત છે અને હળવા સેડેશન હેઠળ યોનિમાર્ગ દ્વારા કરવામાં આવે છે — કોઈ કાપ નહીં, કોઈ ટાંકો નહીં. મોટાભાગના દર્દીઓ લગભગ બે કલાકમાં ઘરે જાય છે."],
  ["Bavishi Fertility Institute માં IVF નો ખર્ચ કેટલો છે?", "ખર્ચ તમારા નિદાન, પ્રોટોકોલ અને ICSI, PGT અથવા ડોનર પ્રોગ્રામ જેવા વધારાના વિકલ્પો પર આધાર રાખે છે. Bavishi Fertility Institute પારદર્શક કિંમત, કોઈ છુપા ચાર્જ વગર, સરળ / વ્યાજમુક્ત EMI અને સુરક્ષા કવચ પેકેજ આપે છે. વ્યક્તિગત અંદાજ માટે કન્સલ્ટેશન બુક કરો."],
  ["શું Bavishi Fertility Institute IVF માટે નાણાકીય સુરક્ષા આપે છે?", "હા — સુરક્ષા કવચ પ્રોગ્રામ દ્વારા, જે ઘણા IVF સાયકલને આવરી લે છે અને તમારી ફર્ટિલિટી સફરમાં નાણાકીય સુરક્ષા આપે છે. તમે પાત્ર છો કે નહીં તે જાણવા અમારી ટીમ સાથે વાત કરો."],
  ["ભારતનું શ્રેષ્ઠ IVF સેન્ટર કયું છે?", "Bavishi Fertility Institute ભારતની સૌથી વિશ્વસનીય IVF ચેઇનમાંની એક છે — 1998 થી 8 શહેરોના 14 કેન્દ્રોમાં કાર્યરત, 30,000+ સફળ ગર્ભાવસ્થા અને છ વખત (2019–2026) નેશનલ ફર્ટિલિટી એવોર્ડ સાથે. અમારી અમદાવાદ સંસ્થાને ટાઇમ્સ ઓફ ઇન્ડિયા દ્વારા ભારતની નંબર 1 ફર્ટિલિટી ક્લિનિક જાહેર કરવામાં આવી હતી."],
  ["IVF શરૂ કરતા પહેલાં મારે જીવનશૈલીમાં કયા ફેરફારો કરવા જોઈએ?", "સ્વસ્થ જીવનશૈલી પર ધ્યાન આપો — સંતુલિત આહાર, નિયમિત કસરત, સ્વસ્થ વજન જાળવવું, અને ધૂમ્રપાન તથા વધુ પડતા દારૂથી દૂર રહેવું. પરામર્શ દરમિયાન તમારા નિષ્ણાત કોઈપણ વધારાની, વ્યક્તિગત સલાહ આપશે."],
  ["શું IVF દરમિયાન આહાર સંબંધિત કોઈ ભલામણો છે?", "કોઈ કડક પ્રતિબંધ નથી, પરંતુ ફળો, શાકભાજી, આખા અનાજ અને લીન પ્રોટીનથી ભરપૂર સંતુલિત આહાર તથા પૂરતું પાણી પીવાની ભલામણ કરવામાં આવે છે. તમારી સારવાર માટે ક્લિનિક જે ચોક્કસ સૂચનાઓ આપે તેનું પાલન કરો."],
  ["એમ્બ્રિયો ગ્રેડિંગ શું છે?", "એમ્બ્રિયો ગ્રેડિંગમાં ભ્રૂણોની ગુણવત્તાનું મૂલ્યાંકન તેમના દેખાવ અને વિકાસના આધારે કરવામાં આવે છે. ઉચ્ચ ગ્રેડના ભ્રૂણો સફળતાપૂર્વક ઇમ્પ્લાન્ટ થવાની સંભાવના વધુ હોય છે, તેથી જ અમારા એમ્બ્રિયોલોજિસ્ટ ટ્રાન્સફર માટે શ્રેષ્ઠ ગુણવત્તાવાળા ભ્રૂણ પસંદ કરે છે."],
  ["શું એકલી વ્યક્તિ IVF દ્વારા બાળક મેળવી શકે?", "હા, ભારતમાં એકલી સ્ત્રીઓ માટે IVF સારવાર ઉપલબ્ધ છે — ડોનર સ્પર્મની મદદથી એકલી સ્ત્રી ગર્ભધારણ કરી શકે છે. અમારી ટીમ તમને ઉપલબ્ધ વિકલ્પો સમજાવશે. દુર્ભાગ્યે, ભારતીય કાયદા હેઠળ એકલા પુરુષો હાલમાં ફર્ટિલિટી સારવાર માટે પાત્ર નથી."],
];
if (ivf.faqs.length !== faqHi.length || faqHi.length !== faqGu.length) throw new Error(`ivf faqs changed: ${ivf.faqs.length}`);
const faqs = ivf.faqs.map((f, i) => ({ _type: "object", q: L(f.q, faqHi[i][0], faqGu[i][0]), a: L(f.a, faqHi[i][1], faqGu[i][1]) }));

// ── cta ──
const cta = {
  heading: L(ivf.cta.heading, "क्या आप अपनी", "શું તમે તમારી"),
  headingEm: L(ivf.cta.headingEm, "IVF यात्रा शुरू करने के लिए तैयार हैं?", "IVF સફર શરૂ કરવા તૈયાર છો?"),
  subtitle: L(ivf.cta.subtitle!, "आज ही हमारे फर्टिलिटी विशेषज्ञों से बात करें — गोपनीय, संवेदनशील और व्यक्तिगत।", "આજે જ અમારા ફર્ટિલિટી નિષ્ણાતો સાથે વાત કરો — ગોપનીય, સંવેદનશીલ અને વ્યક્તિગત."),
};


const patch = {
  "hero.eyebrow": hero.eyebrow, "hero.h1": hero.h1, "hero.h1Em": hero.h1Em, "hero.tagline": hero.tagline, "hero.badges": hero.badges,
  whatIs, benefits, whoNeedsIt, process: process_, risks, faqs, cta,
};

if (DRY) {
  console.log(JSON.stringify(patch, null, 2));
  console.log("\n[dry-run] nothing written. hero.h1 hi/gu:", hero.h1.hi, "|", hero.h1.gu);
  process.exit(0);
}

const sanity = createClient({
  projectId: process.env.NEXT_PUBLIC_SANITY_PROJECT_ID!,
  dataset: process.env.NEXT_PUBLIC_SANITY_DATASET!,
  apiVersion: "2024-01-01",
  useCdn: false,
  token: process.env.SANITY_API_TOKEN!,
});
if (sanity.config().dataset !== "i18n-preview") {
  throw new Error(`Refusing to seed into dataset "${sanity.config().dataset}" — only i18n-preview. Use the admin panel for production.`);
}

const id = "treatment-ivf";
await sanity.createIfNotExists({ _id: id, _type: "treatment", slug: "ivf" });
const { "hero.eyebrow": a, "hero.h1": b, "hero.h1Em": c, "hero.tagline": d, "hero.badges": e, ...sections } = patch;
await sanity
  .patch(id)
  .set({ "hero.eyebrow": a, "hero.h1": b, "hero.h1Em": c, "hero.tagline": d, "hero.badges": e, ...sections })
  .commit({ autoGenerateArrayKeys: true });
console.log(`Seeded hi/gu translations onto ${id} in i18n-preview.`);

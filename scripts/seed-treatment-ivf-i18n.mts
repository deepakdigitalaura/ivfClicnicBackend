/* =====================================================================
 * Seed Hindi + Gujarati translations of the IVF treatment page onto the
 * `treatment` doc with slug "ivf" (id treatment-ivf).
 *
 * Writes {en,hi,gu} objects for the translatable fields the resolver reads
 * (hero, whatIs, benefits, whoNeedsIt, process, risks, faqs, cta). English is
 * taken verbatim from the code default (src/lib/treatments.ts `ivf`), so the
 * English page is unchanged. Only those fields are patched — anything else on
 * the doc (heroPhoto, nav fields, meta) is left alone.
 *
 * SAFETY: like seed-i18n-nav-footer.mts, refuses to run against any dataset
 * except i18n-preview. Production must get this data via the admin panel
 * (or by re-running with the guard consciously changed) AFTER the code that
 * reads {en,hi,gu} shapes is deployed.
 *
 * Run:
 *   npx tsx --env-file=.env.local scripts/seed-treatment-ivf-i18n.mts [--dry-run]
 *   (with NEXT_PUBLIC_SANITY_DATASET=i18n-preview)
 * ===================================================================== */
import { createClient } from "next-sanity";

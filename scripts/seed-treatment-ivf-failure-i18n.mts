type L = { en: string; hi: string; gu: string };
const L = (en: string, hi: string, gu: string): L => ({ en, hi, gu });
function zip(en: string[], hi: string[], gu: string[], label: string): L[] {
  if (en.length !== hi.length || en.length !== gu.length) throw new Error(`${label}: length mismatch en=${en.length} hi=${hi.length} gu=${gu.length}`);
  return en.map((e, i) => L(e, hi[i], gu[i]));
}


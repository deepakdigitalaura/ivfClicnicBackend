  ["ભ્રૂણ ટ્રાન્સફરનો સમય કેટલો મહત્વપૂર્ણ છે?", "ભ્રૂણ ટ્રાન્સફરનો સમય ઇમ્પ્લાન્ટેશન માટે મહત્વપૂર્ણ છે. જ્યાં સંકેત હોય ત્યાં, તેને એન્ડોમેટ્રિયલ રિસેપ્ટિવિટી એરે (ERA) ટેસ્ટ દ્વારા સુધારી શકાય છે, જોકે તેની વાસ્તવિક અસરકારકતા પર અભ્યાસો અનિર્ણિત છે."],
  ["જિનેટિક ટેસ્ટિંગની ભૂમિકા શું છે?", "જિનેટિક ટેસ્ટિંગ આનુવંશિક રીતે સામાન્ય ભ્રૂણોની ઓળખ અને પસંદગીમાં મદદ કરે છે, જેનાથી કસુવાવડનું જોખમ ઘટી શકે છે અને ઇમ્પ્લાન્ટેશન દરમાં સુધારો થઈ શકે છે."],
  ["દંપતી બીજું IVF સાયકલ ક્યારે શરૂ કરી શકે?", "દંપતી જેવા તૈયાર થાય અને અગાઉના સાયકલની સમીક્ષા પૂર્ણ થાય કે તરત આગલું સાયકલ શરૂ કરવાનું વિચારી શકે છે."],
  ["નિષ્ફળ સાયકલ પછી કાઉન્સેલિંગ કેવી રીતે મદદ કરી શકે?", "ઇનફર્ટિલિટી કાઉન્સેલિંગ મુશ્કેલ સમય દરમિયાન લાગણીઓ વ્યક્ત કરવા અને સામનો કરવાની વ્યૂહરચનાઓ વિકસાવવા માટે એક સુરક્ષિત જગ્યા આપે છે."],
  ["સુરક્ષા કવચ પેકેજ શું છે?", "સુરક્ષા કવચ પેકેજ અદ્યતન તકનીકો અને સારવારોને પ્રમાણભૂત રીતે સામેલ કરીને વ્યાપક સુરક્ષા આપે છે. તમે પાત્ર છો કે નહીં તે જાણવા અમારી ટીમ સાથે વાત કરો."],
];
if (t.faqs.length !== faqHi.length || faqHi.length !== faqGu.length) throw new Error(`ivf-failure faqs changed: ${t.faqs.length}`);
const faqs = t.faqs.map((f, i) => ({ _type: "object", q: L(f.q, faqHi[i][0], faqGu[i][0]), a: L(f.a, faqHi[i][1], faqGu[i][1]) }));


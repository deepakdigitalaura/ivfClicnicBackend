# Copy to .env.local and fill in. .env.local is gitignored.

# ── Sanity CMS (replaces Payload) ─────────────────────────────────────────────
# 1. Go to sanity.io → create a new project named "BFI CMS"
# 2. Copy the Project ID from the project dashboard
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Dataset name — "production" is the default
NEXT_PUBLIC_SANITY_DATASET=production
# API token with "Editor" permissions — create at sanity.io → project → API → Tokens
# Required for server-side Sanity reads (used in robots, sitemap, scripts etc.)
SANITY_API_TOKEN=

# ── SMTP (contact form email notifications) ─────────────────────────────────
# Gmail: generate an App Password at myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where inquiry notifications are sent. Defaults to SMTP_USER if unset.
INQUIRY_TO_EMAIL=

# ── Google Places (build-time only) ───────────────────────────────────────────
# Needs Places API enabled + billing in Google Cloud (at ~15 locations fetched
# weekly this stays well within Google's $200/month free credit — $0 in practice).
GOOGLE_PLACES_API_KEY=

# ── Weekly review refresh (Vercel Cron → deploy hook, see vercel.json) ────────
# Vercel project → Settings → Git → Deploy Hooks → create one for the
# production branch, paste its URL here (Production env var only).
REVIEWS_DEPLOY_HOOK_URL=
# Any random string. Vercel Cron sends it back as `Authorization: Bearer …`;
# the /api/cron/refresh-reviews route checks it before triggering a redeploy.
CRON_SECRET=

# ── Legacy — no longer needed (Payload removed) ───────────────────────────────
# DATABASE_URI=
# PAYLOAD_SECRET=
# PREVIEW_SECRET=
# BLOB_READ_WRITE_TOKEN=
# MIGRATE_DATABASE_URI=
